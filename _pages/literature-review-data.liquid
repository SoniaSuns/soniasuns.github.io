---
layout: null
permalink: /assets/data/literature-review.json
sitemap: false
---
{%- assign all_papers = '' | split: '' -%}
{%- for bucket in site.data.literature_review -%}
  {%- if bucket[0] contains 'papers_' -%}
    {%- assign all_papers = all_papers | concat: bucket[1] -%}
  {%- endif -%}
{%- endfor -%}
{ "schema_version": 1, "scope": "paper_notes_only", "updated": {{ site.data.literature_review.catalog.updated | jsonify }}, "records": {{ site.data.literature_review.catalog.records }}, "pages": {{ site.data.literature_review.catalog.pages }}, "historical_aliases": {{ site.data.literature_review.catalog.historical_aliases | jsonify }}, "extracted_locally": {{ site.data.literature_review.catalog.extracted }}, "topic_labels": { "xr": "XR与人机协作", "creation": "创作与规则补全", "world": "世界机制与演化", "ai": "AI方法与评测" }, "papers": {{ all_papers | sort: 'id' | reverse | jsonify }} }
